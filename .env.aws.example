# BookStore Co. - AWS / EC2 deployment example
# Copy to .env on the application host and replace environment-specific values.
# Never commit the resulting .env file.

COMPOSE_PROJECT_NAME=bookstore
NODE_IMAGE=node:24-alpine
NGINX_IMAGE=nginx:1.27-alpine

# Published frontend port
FRONTEND_HOST_PORT=80

# Frontend container / reverse proxy
NGINX_PORT=80
API_PROXY_PREFIX=/api
PROXY_PASS=http://backend:5001

# Vite build-time configuration
VITE_API_BASE_URL=/
VITE_CURRENCY_LOCALE=es-CO
VITE_CURRENCY_CODE=COP

# Backend application
NODE_ENV=production
SERVICE_NAME=bookstore-api
PORT=5001
API_BASE_PATH=/api
CORS_ORIGINS=http://REPLACE_WITH_APPLICATION_HOST
BOOKS_DEFAULT_LIMIT=24
BOOKS_MAX_LIMIT=100
ORDERS_MAX_DISTINCT_ITEMS=100
ORDERS_MAX_QUANTITY_PER_ITEM=1000

# HTTP proxy awareness and enriched access/clickstream logging
HTTP_TRUST_PROXY_HOPS=1
HTTP_JSON_BODY_LIMIT=32kb
ACCESS_LOG_ENABLED=true
ACCESS_LOG_EXCLUDE_PATHS=/health
ACCESS_LOG_MAX_FIELD_LENGTH=2048
ACCESS_LOG_REQUEST_ID_HEADER=X-Request-Id
CLICKSTREAM_FILE_ENABLED=true
CLICKSTREAM_FILE_PATH=/usr/src/app/logs/clickstream.log

# Authentication / instructional session identity
AUTH_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=bookstore-api
AUTH_JWT_AUDIENCE=bookstore-web
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_COOKIE_NAME=bookstore_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api

# Amazon RDS PostgreSQL
DB_HOST=REPLACE_WITH_RDS_ENDPOINT
DB_PORT=5432
DB_NAME=bookstore
APP_DB_USER=bookstore_app
APP_DB_PASSWORD=REPLACE_WITH_APP_DB_PASSWORD
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
