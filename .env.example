# ============================================================
# Docker Compose / local reference environment
# ============================================================

COMPOSE_PROJECT_NAME=bookstore

NODE_IMAGE=node:24-alpine
NGINX_IMAGE=nginx:1.27-alpine
POSTGRES_IMAGE=postgres:17-alpine
BOOTSTRAP_IMAGE=postgres:17

# ============================================================
# Image publishing
# ============================================================

# Registry prefix for the backend and frontend images:
#   local                                          (local builds only)
#   docker.io/<dockerhub-user>                     (Docker Hub)
#   <account-id>.dkr.ecr.<region>.amazonaws.com    (Amazon ECR)
IMAGE_REGISTRY=local

# Image version; keep it aligned with the VERSION file
IMAGE_TAG=8.1.0

# ============================================================
# Published host ports
# ============================================================

FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=5001
POSTGRES_HOST_PORT=5432

# ============================================================
# Frontend container / reverse proxy
# ============================================================

NGINX_PORT=80
API_PROXY_PREFIX=/api
PROXY_PASS=http://backend:5001

# ============================================================
# Vite build-time configuration
# ============================================================

VITE_API_BASE_URL=/
VITE_CURRENCY_LOCALE=es-CO
VITE_CURRENCY_CODE=COP

# ============================================================
# Backend application
# ============================================================

NODE_ENV=development
SERVICE_NAME=bookstore-api
PORT=5001
API_BASE_PATH=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

BOOKS_DEFAULT_LIMIT=24
BOOKS_MAX_LIMIT=100
ORDERS_MAX_DISTINCT_ITEMS=100
ORDERS_MAX_QUANTITY_PER_ITEM=1000

# ============================================================
# HTTP proxy awareness and enriched access/clickstream logging
# ============================================================

HTTP_TRUST_PROXY_HOPS=1
HTTP_JSON_BODY_LIMIT=32kb
ACCESS_LOG_ENABLED=true
ACCESS_LOG_EXCLUDE_PATHS=/health
ACCESS_LOG_MAX_FIELD_LENGTH=2048
ACCESS_LOG_REQUEST_ID_HEADER=X-Request-Id
CLICKSTREAM_FILE_ENABLED=true
CLICKSTREAM_FILE_PATH=/usr/src/app/logs/clickstream.log

# ============================================================
# Authentication / instructional session identity
# ============================================================

AUTH_JWT_SECRET=replace_this_local_secret_with_at_least_32_random_characters
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=bookstore-api
AUTH_JWT_AUDIENCE=bookstore-web
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_COOKIE_NAME=bookstore_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api

# ============================================================
# PostgreSQL connection
# ============================================================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=bookstore

# ============================================================
# Administrative identity (local PostgreSQL and bootstrap only)
# ============================================================

DB_ADMIN_USER=bookstore_admin
DB_ADMIN_PASSWORD=change_me_for_local_development

# ============================================================
# Backend runtime database identity
# ============================================================

APP_DB_USER=bookstore_app
APP_DB_PASSWORD=change_me_for_local_development

# ============================================================
# Data ingestion identity
# ============================================================

INGEST_DB_USER=bookstore_ingest
INGEST_DB_PASSWORD=change_me_for_local_development

# ============================================================
# Database client settings
# ============================================================

DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
